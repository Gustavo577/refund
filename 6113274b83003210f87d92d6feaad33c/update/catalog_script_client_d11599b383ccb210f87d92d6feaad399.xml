        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || !newValue) return;

    var parts = newValue.split("-"); // [yyyy, mm, dd]
    var enteredDate = new Date(parts[0], parts[1] - 1, parts[2]);

    var today = new Date();
    var todayOnly = new Date(today.getFullYear(), today.getMonth(), today.getDate());

    if (enteredDate > todayOnly) {
        g_form.showFieldMsg('expense_date', 'You cannot select a future date for reimbursement.', 'error');
    }
}
]]></script>
